OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash

# 供应商（可选）：deepseek | openai | moonshot | qwen | zhipu | siliconflow | openrouter | groq | ollama | custom
# GEEKAGENT_PROVIDER=deepseek
# 也可用 HI_AGENT_PROVIDER / HI_AGENT_BASE_URL / HI_AGENT_API_KEY / HI_AGENT_MODEL

# 自定义中转站示例：
# GEEKAGENT_PROVIDER=custom
# OPENAI_BASE_URL=https://your-relay.example.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# 厂商专用密钥（可选，未设 OPENAI_API_KEY 时回退）：
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# DASHSCOPE_API_KEY=
# ZHIPU_API_KEY=
# SILICONFLOW_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# 填好后一键写入全局配置 + 用户环境变量：
#   Windows:  .\scripts\setup-env.ps1   或  hi-agent setup-env
#   Linux:    ./scripts/setup-env.sh    或  hi-agent setup-env
# 也可手动复制到 ~/.hi-agent/.env（Windows: %USERPROFILE%\.hi-agent\.env）
# 优先级：进程环境变量 > 工作目录向上最近的 .env > ~/.hi-agent/.env

# 可选：界面与用量
# GEEKAGENT_TUI=0
# GEEKAGENT_STREAM_USAGE=0
# GEEKAGENT_CONTEXT_WINDOW=128000
# GEEKAGENT_FOLD=0
